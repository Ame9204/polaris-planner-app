# Copy this file to "keystore.properties" (same folder) and fill in your own values.
# keystore.properties is in .gitignore, so it stays on your computer only.
#
# storeFile: where your key file is (use forward slashes on Windows)
storeFile=C:/Users/user/polaris-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=polaris
keyPassword=YOUR_KEY_PASSWORD
